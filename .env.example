# --- DATABASE (Supabase) ---
# Use the "Transaction Pooler" URL (port 6543) for DATABASE_URL.
# IMPORTANT: Ensure pgbouncer=true is at the end.
# Example: postgres://postgres.yourproject:yourpassword@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgres://postgres.[PROJECT_ID]:[PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Use the "Session" or "Direct" connection URL (port 5432) for DIRECT_URL (used for migrations).
# Example: postgres://postgres.yourproject:yourpassword@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
DIRECT_URL="postgres://postgres.[PROJECT_ID]:[PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

# --- AUTH (Supabase) ---
NEXT_PUBLIC_SUPABASE_URL="https://yourproject.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- RESEND (Email) ---
RESEND_API_KEY="re_..."

# --- SENTRY ---
NEXT_PUBLIC_SENTRY_DSN="..."
SENTRY_AUTH_TOKEN="..."
