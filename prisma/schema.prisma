generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model GymProfile {
  id                         String    @id @default(cuid())
  name                       String
  slug                       String?   @unique
  email                      String
  phone                      String
  address                    String?
  logo                       String?
  gst                        String?
  userId                     String    @unique
  businessName               String?
  ownerName                  String?
  city                       String?
  state                      String?
  pincode                    String?
  upiId                      String?
  logoUrl                    String?
  invoicePrefix              String    @default("GM")
  isVerified                 Boolean   @default(false)
  emailVerifiedAt            DateTime?
  onboardingStep             Int       @default(0)
  timezone                   String    @default("Asia/Kolkata")
  saasPlan                   SaaSPlan  @default(TRIAL)
  planTier                   PlanTier  @default(TRIAL)
  trialExpiresAt             DateTime?
  futurePlanPreference       String?
  licenseKey                 String?   @unique
  licenseActivatedAt         DateTime?
  taxPercentage              Decimal   @default(18.0) @db.Decimal(5, 2)
  invoiceLinkExpiryDays      Int       @default(30) // Days before shared invoice links expire (0 = never)
  onboardingEmailsSentAt     DateTime?
  lastTrialReminderMilestone Int? // Days left at last reminder (e.g. 30, 15, 7)
  termsAndConditions         String?   @db.Text
  gymRules                   String?   @db.Text
  waWelcomeMsg               String?   @db.Text
  waInvoiceMsg               String?   @db.Text
  waRenewalMsg               String?   @db.Text
  waOverdueMsg               String?   @db.Text

  tempPassword String?

  deletedAt          DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  members            Member[]
  plans              MembershipPlan[]
  products           Product[]
  invoices           Invoice[]
  sales              Sale[]
  expenses           Expense[]
  attendance         Attendance[]
  staff              StaffMember[]
  ptSessions         PTSession[]
  registrationCodeId String?
  registrationCode   RegistrationCode? @relation(fields: [registrationCodeId], references: [id], onDelete: SetNull)
  invoiceSequence    InvoiceSequence?
  auditLogs          AuditLog[]
  leads              Lead[]
}

model InvoiceSequence {
  id           String   @id @default(cuid())
  gymId        String   @unique
  currentValue Int      @default(0)
  version      Int      @default(1) // For Optimistic Concurrency Control
  updatedAt    DateTime @updatedAt

  gym GymProfile @relation(fields: [gymId], references: [id], onDelete: Cascade)
}

model Member {
  id                String               @id @default(cuid())
  name              String
  email             String?
  phone             String
  dateOfBirth       DateTime
  photo             String?
  address           String?
  city              String?
  state             String?
  pincode           String?
  emergencyName     String
  emergencyPhone    String
  emergencyRelation String
  joiningDate       DateTime             @default(now())
  status            MemberStatus         @default(ACTIVE)
  notes             String?
  gymId             String
  deletedAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  attendance        Attendance[]
  invoices          Invoice[]
  gym               GymProfile           @relation(fields: [gymId], references: [id], onDelete: Cascade)
  subscriptions     MemberSubscription[]
  sales             Sale[]
  ptSessions        PTSession[]

  @@index([gymId])
  @@index([gymId, phone])
}

model MembershipPlan {
  id            String               @id @default(cuid())
  name          String
  description   String?
  duration      Int
  price         Decimal              @db.Decimal(10, 2)
  features      String[]
  isActive      Boolean              @default(true)
  gymId         String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  subscriptions MemberSubscription[]
  gym           GymProfile           @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
}

model MemberSubscription {
  id            String             @id @default(cuid())
  memberId      String
  planId        String
  gymId         String // Direct gymId for multi-tenant isolation
  startDate     DateTime
  endDate       DateTime
  price         Decimal            @db.Decimal(10, 2)
  deletedAt     DateTime?
  status        SubscriptionStatus @default(ACTIVE)
  paymentStatus PaymentStatus      @default(PENDING)
  autoRenew     Boolean            @default(false)
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  member        Member             @relation(fields: [memberId], references: [id], onDelete: Restrict)
  plan          MembershipPlan     @relation(fields: [planId], references: [id])
  invoices      Invoice[]

  @@index([gymId])
  @@index([memberId])
  @@index([gymId, status])
  @@index([gymId, endDate])
}

model Product {
  id            String          @id @default(cuid())
  name          String
  category      ProductCategory
  description   String?
  price         Decimal         @db.Decimal(10, 2)
  purchasePrice Decimal?        @db.Decimal(10, 2)
  stock         Int
  lowStockAlert Int             @default(10)
  image         String?
  isActive      Boolean         @default(true)
  gymId         String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  gym           GymProfile      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  sales         Sale[]

  @@index([gymId])
}

model Sale {
  id             String        @id @default(cuid())
  memberId       String?
  productId      String
  gymId          String // Direct gymId for multi-tenant isolation
  quantity       Int
  unitPrice      Decimal       @db.Decimal(10, 2)
  totalAmount    Decimal       @db.Decimal(10, 2)
  discount       Decimal?      @db.Decimal(10, 2)
  finalAmount    Decimal       @db.Decimal(10, 2)
  deletedAt      DateTime?
  paymentMethod  PaymentMethod
  idempotencyKey String?       @unique
  saleDate       DateTime      @default(now())
  createdAt      DateTime      @default(now())
  invoice        Invoice?
  member         Member?       @relation(fields: [memberId], references: [id])
  product        Product       @relation(fields: [productId], references: [id])
  gym            GymProfile    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([memberId])
}

model Invoice {
  id                  String              @id @default(cuid())
  invoiceNumber       String
  type                InvoiceType
  gymId               String
  memberId            String?
  subscriptionId      String?
  saleId              String?             @unique
  subtotal            Decimal             @db.Decimal(10, 2)
  taxAmount           Decimal             @default(0.0) @db.Decimal(10, 2)
  taxPercentage       Decimal?            @db.Decimal(5, 2)
  discount            Decimal?            @db.Decimal(10, 2)
  total               Decimal             @db.Decimal(10, 2)
  amountPaid          Decimal             @default(0.0) @db.Decimal(10, 2)
  balanceDue          Decimal             @default(0.0) @db.Decimal(10, 2)
  shareToken          String?             @unique
  shareTokenExpiresAt DateTime?
  paymentStatus       PaymentStatus       @default(PENDING)
  paymentMethod       PaymentMethod?
  idempotencyKey      String?             @unique
  walkInName          String?
  walkInPhone         String?
  walkInEmail         String?
  walkInAddress       String?
  notes               String?
  deletedAt           DateTime?
  issueDate           DateTime            @default(now())
  dueDate             DateTime?
  createdAt           DateTime            @default(now())
  gym                 GymProfile          @relation(fields: [gymId], references: [id], onDelete: Restrict)
  member              Member?             @relation(fields: [memberId], references: [id])
  sale                Sale?               @relation(fields: [saleId], references: [id])
  subscription        MemberSubscription? @relation(fields: [subscriptionId], references: [id])
  items               InvoiceItem[]

  @@unique([gymId, invoiceNumber])
  @@index([gymId])
  @@index([memberId])
  @@index([gymId, paymentStatus])
}

model InvoiceItem {
  id            String   @id @default(cuid())
  invoiceId     String
  gymId         String // Direct gymId for multi-tenant isolation
  description   String
  quantity      Int
  unitPrice     Decimal  @db.Decimal(10, 2)
  taxPercentage Decimal? @db.Decimal(5, 2)
  taxAmount     Decimal  @default(0.0) @db.Decimal(10, 2)
  amount        Decimal  @db.Decimal(10, 2)
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  userId    String
  gymId     String? // Associated gym if applicable
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([gymId])
}

model Attendance {
  id              String       @id @default(cuid())
  memberId        String?
  staffId         String?
  gymId           String // Direct gymId for multi-tenant isolation
  date            DateTime     @default(now())
  localDateString String
  checkInTime     DateTime     @default(now())
  checkOutTime    DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  member          Member?      @relation(fields: [memberId], references: [id], onDelete: Restrict)
  staff           StaffMember? @relation(fields: [staffId], references: [id], onDelete: Cascade)
  gym             GymProfile   @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([memberId, localDateString])
  @@unique([staffId, localDateString])
  @@index([memberId])
  @@index([staffId])
  @@index([gymId])
}

model RegistrationCode {
  id        String    @id @default(cuid())
  code      String    @unique
  plan      SaaSPlan
  maxUses   Int       @default(1)
  usedCount Int       @default(0)
  expiresAt DateTime?
  isActive  Boolean   @default(true)

  gyms GymProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  PENDING
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PAID
  PENDING
  OVERDUE
  PARTIAL
}

enum ProductCategory {
  PROTEIN
  SUPPLEMENT
  MERCHANDISE
  OTHER
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  OTHER
}

enum InvoiceType {
  MEMBERSHIP
  PRODUCT // Product sale invoices
  WALK_IN // Sales to non-members
  SALE
  RENEWAL
}

enum NotificationType {
  BIRTHDAY
  EXPIRY_REMINDER
  PAYMENT_OVERDUE
  LOW_STOCK
  NEW_MEMBER
  MONTHLY_SUMMARY
}

enum Role {
  STAFF
  TRAINER
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SaaSPlan {
  // NOTE: BASIC, GROWTH, ENTERPRISE were removed in favor of MAIN_PLAN. 
  // Migrations handle the data mapping.
  TRIAL // Default for new gyms
  MAIN_PLAN // Licensed gyms
}

enum PlanTier {
  TRIAL // 60-day premium trial window
  PRO // Licensed/Commercial usage
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  NOT_INTERESTED
  CONVERTED
}

model Lead {
  id           String     @id @default(cuid())
  gymId        String
  name         String
  phone        String
  email        String?
  planInterest String?
  source       String?
  status       LeadStatus @default(NEW)
  notes        String?
  followUpDate DateTime?
  convertedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  gym          GymProfile @relation(fields: [gymId], references: [id])

  @@index([gymId])
  @@index([gymId, status])
  @@index([gymId, phone])
}

model StaffMember {
  id        String   @id @default(cuid())
  userId    String? // Maps to Supabase UUID. Constrained by @@unique([userId, gymId])
  gymId     String // Links to their employer
  name      String
  email     String
  phone     String?
  role      Role     @default(STAFF)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gym GymProfile @relation(fields: [gymId], references: [id], onDelete: Cascade)

  // Trainer related
  ptSessions PTSession[]
  attendance Attendance[]

  @@unique([userId, gymId]) // A user can only have one staff profile per gym
  @@unique([email, gymId]) // Prevent duplicate emails within the same gym
  @@index([gymId])
}

model PTSession {
  id        String        @id @default(cuid())
  gymId     String
  trainerId String // References StaffMember.id (where role=TRAINER)
  memberId  String // References Member.id
  startTime DateTime
  endTime   DateTime
  status    SessionStatus @default(SCHEDULED)
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  trainer StaffMember @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  member  Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  gym     GymProfile  @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([trainerId, startTime])
  @@index([gymId])
  @@index([memberId])
}

model AuditLog {
  id         String   @id @default(cuid())
  gymId      String
  actorId    String // Supabase User ID
  action     String // e.g., "CREATE_MEMBER", "PRINT_INVOICE", "LOGIN"
  entityType String // e.g., "MEMBER", "INVOICE", "AUTH"
  entityId   String?
  payload    Json? // Store changed fields or metadata
  ipAddress  String?
  ipHash     String?
  createdAt  DateTime @default(now())

  gym GymProfile @relation(fields: [gymId], references: [id], onDelete: Restrict)

  @@index([gymId])
  @@index([entityType, entityId])
}

model Expense {
  id          String          @id @default(cuid())
  gymId       String
  amount      Decimal         @db.Decimal(10, 2)
  category    ExpenseCategory
  description String
  date        DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  gym         GymProfile      @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([gymId, date])
}

enum ExpenseCategory {
  RENT
  SALARY
  ELECTRICITY
  MAINTENANCE
  EQUIPMENT
  MARKETING
  OTHER
}
