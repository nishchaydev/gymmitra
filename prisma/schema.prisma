generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model GymProfile {
  id             String           @id @default(cuid())
  name           String
  email          String
  phone          String
  address        String?
  logo           String?
  gst            String?
  userId         String           @unique
  businessName   String?
  city           String?
  state          String?
  pincode        String?
  upiId          String?
  logoUrl        String?
  invoicePrefix  String           @default("GM")
  invoiceCounter Int              @default(0)
  isVerified     Boolean          @default(false)
  onboardingStep Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  members        Member[]
  plans          MembershipPlan[]
  products       Product[]
  invoices       Invoice[]
  sales          Sale[]
  attendance     Attendance[]
}

model Member {
  id                String               @id @default(cuid())
  name              String
  email             String?
  phone             String               @unique
  dateOfBirth       DateTime
  photo             String?
  address           String?
  emergencyName     String
  emergencyPhone    String
  emergencyRelation String
  joiningDate       DateTime             @default(now())
  status            MemberStatus         @default(ACTIVE)
  notes             String?
  gymId             String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  attendance        Attendance[]
  invoices          Invoice[]
  gym               GymProfile           @relation(fields: [gymId], references: [id], onDelete: Cascade)
  subscriptions     MemberSubscription[]
  sales             Sale[]

  @@index([gymId])
  @@index([phone])
  @@index([status])
}

model MembershipPlan {
  id            String               @id @default(cuid())
  name          String
  description   String?
  duration      Int
  price         Decimal              @db.Decimal(10, 2)
  features      String[]
  isActive      Boolean              @default(true)
  gymId         String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  subscriptions MemberSubscription[]
  gym           GymProfile           @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
}

model MemberSubscription {
  id            String             @id @default(cuid())
  memberId      String
  planId        String
  gymId         String             @default("temp-gym-id") // Direct gymId for multi-tenant isolation
  startDate     DateTime
  endDate       DateTime
  price         Decimal            @db.Decimal(10, 2)
  status        SubscriptionStatus @default(ACTIVE)
  paymentStatus PaymentStatus      @default(PENDING)
  autoRenew     Boolean            @default(false)
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  member        Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  plan          MembershipPlan     @relation(fields: [planId], references: [id])
  invoices      Invoice[]

  @@index([gymId])
  @@index([memberId])
  @@index([endDate])
  @@index([status])
}

model Product {
  id            String          @id @default(cuid())
  name          String
  category      ProductCategory
  description   String?
  price         Decimal         @db.Decimal(10, 2)
  stock         Int
  lowStockAlert Int             @default(10)
  image         String?
  isActive      Boolean         @default(true)
  gymId         String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  gym           GymProfile      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  sales         Sale[]

  @@index([gymId])
  @@index([category])
}

model Sale {
  id            String        @id @default(cuid())
  memberId      String?
  productId     String
  gymId         String        // Direct gymId for multi-tenant isolation
  quantity      Int
  unitPrice     Decimal       @db.Decimal(10, 2)
  totalAmount   Decimal       @db.Decimal(10, 2)
  discount      Decimal?      @db.Decimal(10, 2)
  finalAmount   Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod
  saleDate      DateTime      @default(now())
  createdAt     DateTime      @default(now())
  invoice       Invoice?
  member        Member?       @relation(fields: [memberId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])
  gym           GymProfile    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([memberId])
  @@index([productId])
  @@index([saleDate])
}

model Invoice {
  id             String              @id @default(cuid())
  invoiceNumber  String              @unique
  type           InvoiceType
  gymId          String
  memberId       String?
  subscriptionId String?
  saleId         String?             @unique
  subtotal       Decimal             @db.Decimal(10, 2)
  tax            Decimal?            @db.Decimal(10, 2)
  discount       Decimal?            @db.Decimal(10, 2)
  total          Decimal             @db.Decimal(10, 2)
  shareToken     String?             @unique @default(cuid())
  paymentStatus  PaymentStatus       @default(PENDING)
  paymentMethod  PaymentMethod?
  notes          String?
  issueDate      DateTime            @default(now())
  dueDate        DateTime?
  createdAt      DateTime            @default(now())
  gym            GymProfile          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member         Member?             @relation(fields: [memberId], references: [id])
  sale           Sale?               @relation(fields: [saleId], references: [id])
  subscription   MemberSubscription? @relation(fields: [subscriptionId], references: [id])
  items          InvoiceItem[]

  @@index([gymId])
  @@index([invoiceNumber])
  @@index([shareToken])
  @@index([memberId])
  @@index([issueDate])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  gymId       String  @default("temp-gym-id") // Direct gymId for multi-tenant isolation
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  amount      Decimal @db.Decimal(10, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([invoiceId])
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  userId    String
  gymId     String?          // Associated gym if applicable
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([gymId])
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model Attendance {
  id           String    @id @default(cuid())
  memberId     String
  gymId        String    // Direct gymId for multi-tenant isolation
  date         DateTime  @default(now())
  checkInTime  DateTime  @default(now())
  checkOutTime DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  member       Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  gym          GymProfile @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([memberId])
  @@index([date])
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PAID
  PENDING
  OVERDUE
  PARTIAL
}

enum ProductCategory {
  PROTEIN
  SUPPLEMENT
  MERCHANDISE
  OTHER
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  OTHER
}

enum InvoiceType {
  MEMBERSHIP
  SALE
  RENEWAL
}

enum NotificationType {
  BIRTHDAY
  EXPIRY_REMINDER
  PAYMENT_OVERDUE
  LOW_STOCK
  NEW_MEMBER
  MONTHLY_SUMMARY
}
