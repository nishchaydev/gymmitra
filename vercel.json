{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "functions": {
        "app/api/**": {
            "maxDuration": 30
        }
    },
    "crons": [
        {
            "path": "/api/cron/daily-reminders",
            "schedule": "0 1 * * *"
        },
        {
            "path": "/api/cron/expire-subscriptions",
            "schedule": "0 0 * * *"
        },
        {
            "path": "/api/cron/cleanup-notifications",
            "schedule": "0 2 * * 0"
        }
    ]
}